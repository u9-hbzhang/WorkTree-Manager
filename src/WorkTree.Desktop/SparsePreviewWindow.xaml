<Window x:Class="WorkTree.Desktop.SparsePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认目录范围" Width="690" Height="520" MinWidth="550" MinHeight="370"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="18" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="17" />
            <ScrollViewer MaxHeight="100" Margin="0,7,0,8" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ScopeChanges" TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" Foreground="#8E4818">
                    <Run Text="请输入「" /><Hyperlink x:Name="CopyNameLink" Click="CopyName" Foreground="#8E4818"
                        ToolTip="复制工作区名称" AutomationProperties.Name="复制工作区名称"><Run
                        x:Name="WorkspaceName" /></Hyperlink><Run Text="」，确认丢弃列出的本地内容。" />
                </TextBlock>
                <TextBox x:Name="Confirmation" TextChanged="ConfirmationChanged" Margin="0,5,0,0"
                         AutomationProperties.Name="输入工作区名称确认丢弃" />
            </StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="返回" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="Apply" Content="应用范围" Style="{StaticResource PrimaryButton}" Click="Confirm" />
                </StackPanel>
                <ContentControl x:Name="Feedback" Style="{StaticResource Feedback}" Margin="0,0,10,0" />
            </DockPanel>
        </StackPanel>
        <TabControl x:Name="FileTabs">
            <TabItem x:Name="RemovedTab">
                <ListBox x:Name="Removed" VirtualizingPanel.VirtualizationMode="Recycling" />
            </TabItem>
            <TabItem x:Name="ProtectedTab">
                <ListBox x:Name="Protected" VirtualizingPanel.VirtualizationMode="Recycling" />
            </TabItem>
            <TabItem x:Name="BlockingTab">
                <ListBox x:Name="Blocking" VirtualizingPanel.VirtualizationMode="Recycling" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
