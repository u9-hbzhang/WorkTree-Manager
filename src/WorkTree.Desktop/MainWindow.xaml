<Window x:Class="WorkTree.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTree Manager" Width="1280" Height="760" MinWidth="1020" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="3" Height="36" CornerRadius="2"
                                    Background="{StaticResource BorderColor}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch" />
    </Window.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="22,14"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="设置" Click="OpenSettings" IsEnabled="{Binding CanEditSettings}" />
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                        Background="{StaticResource AccentTint}" CornerRadius="5" Padding="9,5"
                        ToolTip="{Binding GitExecutable}">
                    <TextBlock Text="{Binding GitCaption}" Foreground="{StaticResource Accent}" FontSize="12" />
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource Accent}" CornerRadius="8" Width="35" Height="35" Margin="0,0,12,0">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 4,2 L 4,16 M 4,7 L 10,7 L 14,3 M 4,12 L 11,12 L 15,16" />
                    </Border>
                    <TextBlock Text="WorkTree Manager" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionLabel" FontSize="13" Foreground="{StaticResource Muted}"
                               Margin="10,2,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="18,9" Background="#FFF4DB" BorderBrush="#ECD3A0" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBox Text="{Binding Message, Mode=OneWay}" Style="{StaticResource SelectableText}"
                     Foreground="#62430B" MaxHeight="94" VerticalScrollBarVisibility="Auto" />
        </Border>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204*" MinWidth="165" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="710*" MinWidth="440" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="274*" MinWidth="210" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                          ToolTip="拖动调整仓库栏宽度" AutomationProperties.Name="调整仓库栏宽度" />
            <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitter}"
                          ToolTip="拖动调整详情栏宽度" AutomationProperties.Name="调整详情栏宽度" />

            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="9" Padding="13">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,9">
                            <Button DockPanel.Dock="Right" Click="OpenRepositoryMenu"
                                    IsEnabled="{Binding CanManageRepository}" ToolTip="更多仓库操作"
                                    AutomationProperties.Name="更多仓库操作" Width="32" Height="30"
                                    MinHeight="30" Padding="0" Background="{StaticResource Canvas}"
                                    BorderBrush="Transparent" Foreground="{StaticResource Muted}">
                                <TextBlock Text="⋯" FontSize="20" FontWeight="SemiBold" />
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom" Padding="5" Background="{StaticResource Surface}"
                                                 BorderBrush="{StaticResource BorderColor}"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                <Setter Property="Padding" Value="11,7" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="MenuItem">
                                                            <Border x:Name="ItemFrame" CornerRadius="5" Background="Transparent"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                    <Setter TargetName="ItemFrame" Property="Background" Value="{StaticResource AccentTint}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="ItemFrame" Property="Opacity" Value="0.45" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ContextMenu.Resources>
                                        <MenuItem Header="重新定位仓库" Click="RelocateRepository" />
                                        <MenuItem Header="清理失效登记" IsEnabled="{Binding CanCreateWorktree}" Click="PruneWorktrees" />
                                        <Separator Margin="6,3" />
                                        <MenuItem Header="从列表移除仓库" Foreground="#A13227" Click="RemoveRepository" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock Text="仓库" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <Button Content="＋ 添加仓库" Style="{StaticResource PrimaryButton}" Click="AddRepository"
                                IsEnabled="{Binding CanAddRepository}" Margin="0,0,0,10" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                             IsEnabled="{Binding CanEditSettings}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="本地仓库">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="Margin" Value="0,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding MainPath}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MainPath}" Foreground="{StaticResource Muted}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="9" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,13">
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}"
                                ToolTip="刷新工作区登记和状态 (F5)" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="创建工作区" Click="CreateSparseWorktree"
                                IsEnabled="{Binding CanCreateWorktree}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding RepositoryTitle}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RepositoryPath}" ToolTip="{Binding RepositoryPath}"
                                       FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="搜索名称、分支或路径" />
                        <TextBlock Text="搜索名称、分支或路径" Margin="10,0" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Border Grid.Row="2" Margin="0,8,0,6">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource HintPanel}">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListRefreshing}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HintTint}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ListCaption}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListRefreshing}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Hint}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Grid Grid.Row="3">
                        <DataGrid x:Name="WorktreeGrid" ItemsSource="{Binding Rows}"
                                  SelectedItem="{Binding SelectedWorktree, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  RowHeight="47" ColumnHeaderHeight="33" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF1F6" BorderThickness="1"
                                  BorderBrush="{StaticResource BorderColor}" Background="White"
                                  AutomationProperties.Name="工作区列表">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="Background" Value="#F1F4F9" />
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentTint}" />
                                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="MouseDoubleClick" Handler="OpenWorktreeRow" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="工作区 / 路径" Width="1.25*" MinWidth="124" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding PathText}">
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}{1}">
                                                            <Binding Path="Name" />
                                                            <Binding Path="MainMarker" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PathText}" Foreground="{StaticResource Muted}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="分支" Width="*" MinWidth="104" SortMemberPath="Branch">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Branch}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Branch}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="检出" Binding="{Binding Mode}" Width="65" />
                                <DataGridTemplateColumn Header="状态" Width="97" SortMemberPath="State">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding State}" FontSize="12" />
                                                <TextBlock Text="已锁定" Foreground="#704F12" FontSize="10" ToolTip="{Binding Lock}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Entry.IsLocked}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding EmptyListText}" IsHitTestVisible="False" Margin="12,49,12,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{StaticResource Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=WorktreeGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="9" Padding="14">
                <Grid>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWorktree}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="工作区详情" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="选择一个工作区以查看详情。" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWorktree}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedWorktree.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedWorktree.Kind}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,5,0,0" />
                            <WrapPanel Margin="0,13,0,0">
                                <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}" Padding="9,6" Margin="0,0,5,5" />
                                <Button Content="复制路径" Command="{Binding CopyPathCommand}" Padding="9,6" Margin="0,0,0,5" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" ContentStringFormat="用 {0} 打开" Tag="{Binding}"
                                                IsEnabled="{Binding DataContext.SelectedWorktree.CanOpen, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Click="OpenExternalTool" HorizontalAlignment="Left" Margin="0,0,0,5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="调整稀疏范围" Click="AdjustSparseWorktree" HorizontalAlignment="Left"
                                    IsEnabled="{Binding SelectedWorktree.CanAdjustScope}" Margin="0,2,0,4" />
                            <Button Content="删除工作区" Click="DeleteWorktree" HorizontalAlignment="Left"
                                    Foreground="#A13227" IsEnabled="{Binding SelectedWorktree.CanRemove}" Margin="0,2,0,4" />
                            <TextBlock Text="路径" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedWorktree.PathText, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                            <TextBlock Text="分支" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedWorktree.Branch, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                            <TextBlock Text="当前提交" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedWorktree.Commit, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                     FontFamily="Consolas" FontSize="12" />
                            <TextBlock Text="稀疏范围" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedWorktree.SparseScope, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                     MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="锁定及登记状态" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SelectedWorktree.Lock}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedWorktree.Prune}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                            <TextBox Text="{Binding SelectedWorktree.Error, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                     Foreground="#8E4818" MaxHeight="112" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="上次检查" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SelectedWorktree.CheckedAt}" />
                            <TextBlock Text="文件大小" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" />
                            <Button Content="统计文件大小" Command="{Binding MeasureCommand}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" ToolTip="按需统计工作文件逻辑大小，跳过仓库元数据和目录链接。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
